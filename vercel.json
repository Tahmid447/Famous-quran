{
  "buildCommand": "node build.mjs && node upgrade.mjs",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/mushaf.js": {
      "maxDuration": 20
    },
    "api/recordings.js": {
      "maxDuration": 60
    },
    "api/community-videos.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
